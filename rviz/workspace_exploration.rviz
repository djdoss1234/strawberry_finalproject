Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Workspace Grid
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 14
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.25
      Name: Base Link Axes
      Radius: 0.012
      Reference Frame: base_link
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /strawberry/exploration/workspace_cells
      Name: Quadtree Workspace Cells
      Namespaces:
        workspace_cell_centers: true
        workspace_cell_labels: true
        workspace_cells: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /strawberry/scan_poses/tcp_preview
      Name: v12 Scan TCP And Camera Preview
      Namespaces:
        v12_base_link_label: true
        v12_camera_center: true
        v12_camera_optical_axis: true
        v12_gripper_forward_axis: true
        v12_scan_tcp_position: true
      Value: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.45
      Focal Point:
        X: 0.005
        Y: -0.005
        Z: 0
      Name: Current View
      Pitch: 1.5707
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 1.5707
    Saved: ~
